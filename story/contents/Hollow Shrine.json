  "metadata": {
    "title": "The Hollow Shrine",
    "summary": "A forgotten roadside shrine has begun whispering at night. Villagers blame a wandering cult; the shrine itself may disagree.",
    "tags": ["cult", "shrine", "mystery", "moral_choice"],
    "biome": "forest",
    "min_level": 4
  },

  "requirements": {
    "min_player_level": 4,
    "location": [340.0, 210.0],
    "max_distance": 80.0,
    "required_story_ids": [],
    "cooldown_hours": 0,
    "condition": null
  },

  "stages": [
    { "id": 0, "name": "rumor",      "objective": "Find the old shrine said to whisper at night.",  "dialogue_id": "rumor_intro" },
    { "id": 1, "name": "discovered", "objective": "Inspect the shrine and the cultist camp nearby.", "dialogue_id": "shrine_found" },
    { "id": 2, "name": "choice",     "objective": "Decide the shrine's fate.", "dialogue_id": "shrine_choice",
      "on_enter": [ { "type": "modify_reputation", "faction": "wardens", "delta": 1 } ] },
    { "id": 3, "name": "resolved",   "objective": "Return to Northfield and report what you found.", "dialogue_id": "shrine_resolved" }
  ],

  "search_area": { "center": [340.0, 210.0], "size": [40, 40] },

  "npcs": [
    { "id": "cultist_watcher_1", "type": "cultist", "role": "guard",
      "position": [342.0, 208.0], "hostile": true, "group_id": "shrine_cult",
      "dialogue_id": null },
    { "id": "cultist_watcher_2", "type": "cultist", "role": "guard",
      "position": [338.0, 212.0], "hostile": true, "group_id": "shrine_cult" },
    { "id": "cult_speaker", "type": "cultist", "role": "speaker",
      "position": [340.0, 205.0], "hostile": false, "group_id": "shrine_cult",
      "dialogue_id": "speaker_pleads",
      "note": "Non-hostile unless attacked; offers the 'spare the shrine' path." }
  ],

  "objects": [
    { "object_type": "shrine", "id": "hollow_shrine_altar", "position": [340.0, 205.0], "repeatable": true,
      "data": { "aura": "faint_whisper" } },
    { "object_type": "journal", "id": "cult_journal", "position": [343.0, 206.0], "repeatable": false,
      "data": { "dialogue_id": "cult_journal_read" } },
    { "object_type": "tracks", "id": "shrine_tracks", "position": [335.0, 215.0], "repeatable": false }
  ],

  "triggers": [
    {
      "rule_id": "shrine_first_seen",
      "trigger_type": "inspect_object",
      "target_id": "hollow_shrine_altar",
