        "condition": { "type": "quest_flag", "story_id": "hollow_shrine", "key": "chose_destroy", "value": true } },
      { "outcome": "completed", "next_node_id": "sanctum_secrets",
        "condition": { "type": "quest_flag", "story_id": "hollow_shrine", "key": "chose_spare", "value": true } },
      { "outcome": "failed", "next_node_id": "cult_expansion" }
    ]
  }
}